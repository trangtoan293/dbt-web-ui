# Copy to .env and fill in. Never commit .env.
#
# Fastest local start (no OIDC provider needed):
#   AUTH_DISABLED=true
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)   # URL-safe: goes into DATABASE_URL
#   APP_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   AUTH_SECRET=$(openssl rand -base64 32)
# Or run ./scripts/generate-secrets.sh to fill the three secrets.

# ============================================
# Auth mode
# AUTH_DISABLED=true  -> single-user, no login, no identity provider. Everything
#   runs as one fixed local user. Only safe on localhost or a trusted network —
#   never expose an AUTH_DISABLED instance to the internet.
# AUTH_DISABLED=false -> multi-user via OIDC (fill the OIDC block below).
# ============================================
AUTH_DISABLED=true

# ============================================
# Required secrets
# ============================================
# Postgres password for the bundled database. It is interpolated into
# DATABASE_URL, so use URL-safe characters only (hex is a safe choice):
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# AES key (32-byte base64) encrypting stored warehouse and git credentials.
APP_ENCRYPTION_KEY=
# Session cookie signing secret (32-byte base64).
AUTH_SECRET=

# ============================================
# OIDC — only needed when AUTH_DISABLED=false
# Any spec-compliant provider works: Keycloak, Authentik, Zitadel, Auth0,
# Microsoft Entra, Google. Endpoints are read from
# ${OIDC_ISSUER}/.well-known/openid-configuration, so only the issuer is needed.
# Register the redirect URI ${NEXTAUTH_URL}/api/auth/callback/oidc with your
# provider.
# ============================================
OIDC_ISSUER=https://idp.example.com/realms/your-realm
OIDC_CLIENT_ID=dbt-craft
OIDC_CLIENT_SECRET=
# Expected `aud` claim on access tokens, verified by the backend.
OIDC_AUDIENCE=dbt-craft
# Names your provider on the sign-in button ("Continue with Keycloak").
# Defaults to "single sign-on" when unset.
OIDC_PROVIDER_NAME=Keycloak
# Override only if your provider does not publish a discovery document.
# OIDC_JWKS_URI=

# ============================================
# Optional
# ============================================
# Public URL of the app. Must match what the browser uses.
NEXTAUTH_URL=http://localhost:3000
# Internal address of dbt-runner, used server-side by the /api/dbt-runner
# proxy. Compose sets this to http://dbt-runner:8080 automatically; only set it
# here when running the frontend on the host against a different backend.
# DBT_RUNNER_URL=http://localhost:8080
# Name shown in the UI and page title.
NEXT_PUBLIC_PRODUCT_NAME=dbt-craft
# JSON origin allowlist for the backend's CORS middleware.
# Never use ["*"] — the browser sends credentialed requests.
# Keep the single quotes: without them `source .env` strips the inner quotes
# and the backend fails to parse the value.
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# Global cap on concurrent dbt runs; further runs get HTTP 429. Each run is a
# DuckDB process holding its own memory share, so raising this shrinks every
# run's memory. Three heavy runs already saturate one node's disk bandwidth.
MAX_CONCURRENT_DBT_RUNS=3
# Ad-hoc SQL console queries, capped separately from runs so a console stays
# usable while a batch is running. A query is a DuckDB instance doing work, so
# this is ADDED to the run cap when DUCKDB_MEMORY_LIMIT is derived: raising it
# shrinks every run and every query on the same box. Benchmark before raising.
MAX_CONCURRENT_QUERIES=2
# Console query timeout. 60s was fine against a small warehouse and is not
# against a few TB of Parquet, where a scan that legitimately spills runs for
# minutes. MAX_CONCURRENT_QUERIES, not this, is what protects the box.
DBT_INLINE_QUERY_TIMEOUT=300
# A warm worker is a live dbt process holding its project's warehouse open, plus
# a Postgres connection when the project attaches the lake. Pools are created per
# project on demand and reclaimed: idle ones first, then least-recently-used.
DBT_WARM_WORKER_MAX_PROJECTS=8
DBT_WARM_WORKER_IDLE_SECONDS=900
# Commands per project. 1 because a file-backed DuckDB warehouse is single-writer.
# Raise only where every target is remote (Postgres, Oracle, Dremio, Spark).
MAX_CONCURRENT_COMMANDS_PER_PROJECT=1
# Build the dbt-runner image with the dbt-spark adapter (adds a JRE + PySpark).
INSTALL_DBT_SPARK=false

# ============================================
# DuckDB query engine
#
# DuckDB *is* the engine here: dbt-duckdb runs it, and the DuckLake lakehouse is
# read through it. It is a single-node engine, which is fine for terabytes of
# Parquet - a query reads the columns and partitions it needs, not the volume -
# but it must be told what share of the machine it may take. Left unconfigured
# each dbt run claims ~80% of visible memory, and MAX_CONCURRENT_DBT_RUNS of
# them over-commit the box until the kernel kills one mid-run.
# ============================================
# Memory ceiling for the dbt-runner container. 0 is unlimited, i.e. the whole
# host. Set this on a box shared with anything else: the per-run DuckDB limit
# below is derived from it.
DBT_RUNNER_MEM_LIMIT=0
# Per-run DuckDB memory. Empty derives a share of the container's memory divided
# by MAX_CONCURRENT_DBT_RUNS. Set e.g. 24GB to pin it instead.
DUCKDB_MEMORY_LIMIT=
# 0 lets DuckDB use every core. This multiplies with `threads` in profiles.yml,
# which is dbt's model concurrency, so cap it when runs share a box.
DUCKDB_THREADS=0
# Spill directory. DuckDB's own default is `<db file>.tmp`, inside the dbt
# project volume, which is not the volume sized for data: one large aggregate
# fills it and the run dies on "No space left on device".
DUCKDB_TEMP_DIR=/data/storage/duckdb-tmp
# Cap on spill, e.g. 200GB. Empty leaves DuckDB's default (90% of free disk).
DUCKDB_MAX_TEMP_DIRECTORY_SIZE=
# false trades row order for a large drop in peak memory on TB-scale scans and
# writes. Empty keeps DuckDB's default (true) - setting it reorders model output,
# so it is opt-in per deployment.
DUCKDB_PRESERVE_INSERTION_ORDER=

# ============================================
# Scheduler, notifications and retention
# The runner elects one leader through Redis, so these apply once per
# deployment however many workers or replicas are running.
# ============================================
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# A schedule due longer ago than this is skipped instead of run, so an outage
# does not fire the whole backlog at once.
SCHEDULER_MISFIRE_GRACE_SECONDS=3600
# Delivery timeout for a schedule's failure webhook.
WEBHOOK_TIMEOUT_SECONDS=10
# dbt_runs rows store full log text, so history is the fastest growing table in
# the deployment. 0 keeps everything forever.
RUN_HISTORY_RETENTION_DAYS=90
MAINTENANCE_INTERVAL_HOURS=24
# DuckLake keeps every snapshot, dbt leaves __dbt_backup tables behind, and
# appending loads leave many small Parquet files. Maintenance merges those files
# and expires snapshots older than this. 0 disables lake maintenance.
LAKE_SNAPSHOT_RETENTION_DAYS=7
# DuckLake catalog. Empty means the application database, which is the simple
# default and the wrong one past a few hundred GB: the catalog holds a row per
# Parquet file per snapshot, so it becomes a hot table competing with every
# application query. Point it at its own Postgres for a warehouse at that scale.
# LAKE_CATALOG_URL=postgresql://lake:pw@lake-postgres:5432/lakecatalog
# Log tail kept per ingest load. dlt is chatty and a load can run for an hour.
INGEST_RUN_LOG_MAX_CHARS=262144

# --- Publishing lake marts as Iceberg ---------------------------------------
# DuckLake is cheap to write but today only DuckDB reads it. Publishing a mart
# schema as Iceberg makes it readable by Spark, Trino, Athena, BigQuery and the
# rest: POST /lake/iceberg/{project_id} with {"schema":"marts"}.
#
# The Parquet is COPIED, not registered in place. Lake maintenance rewrites and
# then deletes a table's files, and DuckLake cannot see an Iceberg table pointing
# at them - sharing files between two catalogs that each run their own garbage
# collector breaks the published table. Marts are aggregates, so copying is cheap;
# a re-publish after an append copies only the new files.
#
# Catalog: empty falls back to LAKE_CATALOG_URL, then DATABASE_URL. This is an
# Iceberg JDBC catalog, so Trino (iceberg.catalog.type=jdbc) and Spark can read it.
# ICEBERG_CATALOG_URL=postgresql://lake:pw@lake-postgres:5432/lakecatalog
# Warehouse. Must NOT be under LAKE_DATA_DIR: the lake's orphan cleanup scans
# that tree and would delete these copies.
ICEBERG_WAREHOUSE_DIR=/data/storage/iceberg

# ============================================
# Host port bindings (all bound to 127.0.0.1)
# ============================================
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5434
REDIS_PORT=6379

# ============================================
# Host-side development only
# Inside Compose the services reach Postgres at postgres:5432. This URL uses
# the published loopback port so `npx prisma migrate dev` works from the host.
# ============================================
DATABASE_URL=postgresql://dbtcraft:CHANGE_ME@localhost:5434/dbtcraft
